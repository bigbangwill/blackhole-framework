.segmented-value-bar {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-grow: 1;
    height: 100%;
    min-width: 0;
}

.segmented-value-bar__segment {
    height: 38%;
    aspect-ratio: 1;
    margin-right: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgba(130, 137, 140, 0.78);
}

.segmented-value-bar__segment--filled {
    background-color: rgb(11, 171, 145);
}
