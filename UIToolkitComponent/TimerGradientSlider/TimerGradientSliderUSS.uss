.timer-gradient-slider {
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.timer-gradient-slider__track {
    flex-grow: 1;
    width: auto;
    height: 100%;
    min-width: 0;
    min-height: 0;
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0.45);
    overflow: hidden;
    position: relative;
}

.timer-gradient-slider__fill {
    height: 100%;
    width: 100%;
    border-radius: 15px;
    transition-property: width, background-color;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.timer-gradient-slider__label {
    height: 100%;
    min-width: 90px;
    margin-left: 2%;
    unity-text-align: middle-center;
    color: white;
    font-size: 40%;
    -unity-font-style: bold;
}




