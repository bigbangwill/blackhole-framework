.panel-transition-slide-left {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 250ms, 250ms;
    transition-timing-function: ease-out, ease-out;
}

.panel-transition-slide-left.panel-hidden {
    opacity: 0;
    translate: -8% 0;
}

.panel-transition-slide-left.panel-visible {
    opacity: 1;
    translate: 0 0;
}
