.panel-transition-from-top {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 250ms, 250ms;
    transition-timing-function: ease-out, ease-out;
}

.panel-transition-from-top.panel-hidden {
    opacity: 0;
    translate: 0 -100%;
}

.panel-transition-from-top.panel-visible {
    opacity: 1;
    translate: 0 0;
}
