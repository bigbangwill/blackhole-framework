.panel-transition-scale-fade {
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 250ms, 250ms;
    transition-timing-function: ease-out, ease-out;
}

.panel-transition-scale-fade.panel-hidden {
    opacity: 0;
    scale: 0.9 0.9;
}

.panel-transition-scale-fade.panel-visible {
    opacity: 1;
    scale: 1 1;
}
