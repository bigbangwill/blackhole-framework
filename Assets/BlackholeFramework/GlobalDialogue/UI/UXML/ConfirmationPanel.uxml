<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/BlackholeFramework/SharedKernel/Presentaition/USS/global-style.uss?fileID=7433441132597879392&amp;guid=407997d14dbb3524bbe3606d30194f3f&amp;type=3#global-style"/>
    <Style src="project://database/Assets/BlackholeFramework/GlobalDialogue/UI/USS/confirmation-panel-style.uss?fileID=7433441132597879392&amp;guid=dac1ededadcf30b44b3f27f11e93df70&amp;type=3#confirmation-panel-style"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" class="ori-landscape" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
        <ui:VisualElement name="ConfirmationPanelVE" style="flex-grow: 1; width: 100%; height: 100%; display: none; background-color: rgba(0, 0, 0, 0.475);">
            <ui:VisualElement name="Holder">
                <ui:VisualElement name="DialouguePanel" style="background-color: rgba(0, 0, 0, 0.706);">
                    <ui:Label text="نمسیتب سیت ستیمب تمسنی تمنبستم سیتب سیم بتمشسیتم بتسمی تسبمین نیسب سا یمبسیبهخ نسیدب جسهیب خد ه خصدخ دبنید سبسیم پدد خحهیبسمیپ نید هخسشیبن دسنی دبهسید نیسدب نسیب هسی د هنی هثد ین دهب دسین دهسی دینبسد هب نسیدش مدیب هزو یهبه زو دهی نیسوز ی ه. " name="DetailLabel" language-direction="RTL" class="global-font" style="-unity-text-auto-size: best-fit 2px 35px; color: rgb(255, 255, 255); white-space: pre-wrap; width: 825px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="ButtonsHolder" style="flex-grow: 0;">
                    <ui:VisualElement name="YesOrNoButtonHolder" style="flex-grow: 0; width: 100%; height: 100%; display: flex; flex-direction: row; justify-content: space-around;">
                        <BigBang.UIToolkitComponent.AnimatedButton language-direction="RTL" text="آری" name="YesButton" class="global-big-button global-font" style="width: 40%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-text-align: middle-center; -unity-text-auto-size: best-fit 20px 35px;"/>
                        <BigBang.UIToolkitComponent.AnimatedButton language-direction="RTL" text="خیر" name="NoButton" class="global-big-button global-font" style="width: 40%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-text-align: middle-center; -unity-text-auto-size: best-fit 20px 35px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ConfirmButtonHolder" style="flex-grow: 0; width: 100%; height: 100%; display: none; flex-direction: row; justify-content: space-around;">
                        <BigBang.UIToolkitComponent.AnimatedButton language-direction="RTL" text="خیر" name="ConfirmButton" class="global-big-button global-font" style="width: 40%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-text-align: middle-center;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TopHolder" picking-mode="Ignore" class="global-top-holder" style="flex-direction: row;">
            <BigBang.UIToolkitComponent.AnimatedButton name="FullScreenButton" class="global-small-button" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 85px; margin-right: 0%; align-self: center; margin-left: 20px; background-image: url(&quot;project://database/Assets/BlackholeFramework/GlobalDialogue/Scripts/Texture/FullscrennIcon.png?fileID=2800000&amp;guid=11da6bc70d4090f47953ef6459d44d08&amp;type=3#FullscrennIcon&quot;); background-size: 70% 70%; height: 90px; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
