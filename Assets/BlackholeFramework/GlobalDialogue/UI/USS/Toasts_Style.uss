#Root.ori-landscape #NotificationVE {
    width: 45%;
    height: 100%;
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
}

#Root.ori-landscape #NotificationVE > .toast-style {
    width: 65%;
    height: 10%;
    align-self: center;
    position: relative;
    background-color: rgba(255, 255, 255, 0);
    margin-top: 10px;
    padding-bottom: 0;
    margin-bottom: 10px;
    background-image: url("project://database/Assets/BlackholeFramework/GlobalDialogue/Scripts/Texture/toast.png?fileID=2800000&guid=7589e128491f40642955079ec9fdb255&type=3#toast");
    -unity-background-scale-mode: scale-to-fit;
    flex-direction: row-reverse;
}

#Root.ori-landscape #NotificationVE > .toast-style > .toast-label {
    width: 75%;
    height: 75%;
    align-self: center;
    position: relative;
    background-color: rgba(219, 65, 75, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    padding-bottom: 0;
    margin-bottom: 0;
    -unity-text-auto-size: best-fit 10px 40px;
    -unity-text-align: middle-right;
    white-space: pre-wrap;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    color: rgb(255, 255, 255);
    margin-right: 35px;
    -unity-font-definition: url("project://database/Assets/BlackholeFramework/SharedKernel/Presentaition/Fonts/IRANSans(FaNum)_Bold.ttf?fileID=12800000&guid=700ad6ca9fbdc1849860dbe9504c49db&type=3#IRANSans(FaNum)_Bold");
}

#Root.ori-landscape #NotificationVE > .toast-style > .toast-circle {
    flex-grow: 0;
    border-top-left-radius: 100px;
    border-top-right-radius: 100px;
    border-bottom-right-radius: 100px;
    border-bottom-left-radius: 100px;
    background-color: rgb(47, 255, 6);
    aspect-ratio: 1;
    align-self: center;
    width: 50px;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 20px;
    margin-left: 10px;
}

#Root.ori-portrait #NotificationVE {
    width: 50%;
    height: 100%;
    align-self: center;
}

#Root.ori-portrait #NotificationVE > .toast-style {
    width: 100%;
    height: 4%;
    align-self: center;
    position: relative;
    background-color: rgb(149, 219, 65);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    margin-top: 10px;
    padding-bottom: 0;
    margin-bottom: 10px;
}

#Root.ori-portrait #NotificationVE > .toast-style > .toast-label {
    width: 90%;
    height: 85%;
    align-self: center;
    position: relative;
    background-color: rgba(219, 65, 75, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 10px;
    -unity-text-auto-size: best-fit 30px 50px;
    -unity-text-align: middle-left;
    white-space: pre-wrap;
    padding-left: 20px;
    padding-right: 10px;
    padding-top: 5px;
}
